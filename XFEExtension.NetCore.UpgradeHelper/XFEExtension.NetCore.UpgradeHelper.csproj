<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0</Version>
    <Nullable>enable</Nullable>
    <PackageIcon>logoIcon.png</PackageIcon>
    <Title>XFEExtension.NetCore.UpgradeHelper</Title>
    <Authors>XFEstudio</Authors>
    <Description>对接ApplicationUpgradeManager的nuget包，可以快速实现软件版本更新请求</Description>
    <Copyright>寰宇朽力网络科技有限公司版权所有</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>
      升级至 net10.0 并更新依赖包版本

      将项目目标框架从 net8.0 升级为 net10.0，同时将 XFEExtension.NetCore 包从 3.3.1 升级到 4.2.3，XFEExtension.NetCore.XUnit 包从 2.0.4 升级到 3.0.0，以获得新特性和更好的兼容性。
    </PackageReleaseNotes>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageProjectUrl>https://github.com/XFEstudio/XFEExtension.NetCore.UpgradeHelper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/XFEstudio/XFEExtension.NetCore.UpgradeHelper.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\logoIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="XFEExtension.NetCore" Version="4.2.3" />
  </ItemGroup>

</Project>
